{
  "name": "jev-computer-use",
  "version": "0.1.0",
  "description": "Jev (TypeSafe System One) UI-candidate selection CLI, a bounded CDP browser message workflow, a read-only Unity Analytics (Snowflake) daily report for Pi, and its unattended daily wrapper",
  "type": "module",
  "bin": {
    "jev-cu": "bin/jev-cu.mjs",
    "jev-cu-browse": "bin/jev-cu-browse.mjs",
    "jev-cu-report": "bin/jev-cu-report.mjs",
    "jev-cu-daily": "bin/jev-cu-daily.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "serve:synthetic-slack": "node scripts/serve-synthetic-slack.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2"
  }
}
